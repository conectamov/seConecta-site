# Invite URL for the seConecta WhatsApp community group.
NEXT_PUBLIC_SECONNECTA_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/your-invite-code

# Public production origin used by canonical URLs, OpenGraph, JSON-LD, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://seconecta.com.br

# Server-only API origin. Never expose the Railway URL through NEXT_PUBLIC
# variables or store backend JWTs in browser JavaScript.
SECONNECTA_API_URL=http://localhost:8000

# Student capabilities are independently reversible at the frontend boundary.
NEXT_PUBLIC_SECONNECTA_STUDENT_ENABLED=true
NEXT_PUBLIC_SECONNECTA_RECOMMENDATIONS_ENABLED=true
# Post-onboarding persistence CTA and activation telemetry. Variant changes
# visual hierarchy only; both channels remain available.
NEXT_PUBLIC_SECONNECTA_MULTICHANNEL_ACTIVATION_ENABLED=false
NEXT_PUBLIC_SECONNECTA_ACTIVATION_VARIANT=WHATSAPP_PRIMARY

# Independent staff rollout flags.
STAFF_PORTAL_ENABLED=false
CURATION_WORKFLOW_ENABLED=false
STAFF_USER_WORKSPACE_V2_ENABLED=false
NEXT_PUBLIC_STAFF_PORTAL_ENABLED=false
NEXT_PUBLIC_CURATION_WORKFLOW_ENABLED=false
NEXT_PUBLIC_CURATION_STAGE_FEED_SHADOW_ENABLED=false
NEXT_PUBLIC_CURATION_STAGE_FEED_GATE_ENABLED=false
